# Copy to .env and fill in. .env is never committed.

# Any password you choose; only your local Postgres uses it.
TREENIVIHKO_POSTGRES_PASSWORD=

# The development database, and the one the integration tests use. Put the
# same password in both; the test database's name must end in _test.
DATABASE_URL=postgresql://postgres:<password>@localhost:5433/treenivihko
TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5433/treenivihko_test
