{
  "name": "treenivihko",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit --project unit-dom --coverage && tsx scripts/coverage-gaps.ts",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "test:e2e:browser": "playwright install chromium",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down",
    "db:generate": "tsx scripts/generate-migration.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check-history": "tsx scripts/migration-history.ts",
    "db:studio": "drizzle-kit studio",
    "trainer:set-password": "tsx scripts/set-trainer-password.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "railway": "3.15.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
